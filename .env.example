# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# Then fill in the two values from your Supabase project settings
# (Project Settings -> API, or the "Connect" button on your project
# dashboard). On newer Supabase projects this key may be labeled
# "Publishable key" (sb_publishable_...) rather than the older "anon key"
# (eyJ...) format -- either works the same way here.
#
# On Netlify, set these same two variables under
# Project configuration -> Environment variables instead of using this file.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
