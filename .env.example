# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# Then fill in the two values from your Supabase project settings
# (Project Settings -> API, or the "Connect" button on your project
# dashboard). On newer Supabase projects this key may be labeled
# "Publishable key" (sb_publishable_...) rather than the older "anon key"
# (eyJ...) format -- either works the same way here.
#
# On Netlify, set these same two variables under
# Project configuration -> Environment variables instead of using this file.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key


# ---------------------------------------------------------------------------------------------------------------
# Automatic WhatsApp sending (update 49) -- OPTIONAL, and these belong in NETLIFY ONLY.
#
# Do NOT put them in .env.local and never commit real values: they are secrets, and they must never reach the
# browser. Add each one under Netlify -> Project configuration -> Environment variables (tick "Contains secret
# values" for the ones marked secret), then redeploy. Where to find every value, and how to set up Meta's side, is
# in WHATSAPP-SETUP.md. Without them the app keeps working: WhatsApp opens and you press Send yourself.
#
# The functions reuse VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY above. Only if the "Set up WhatsApp sending" check
# says they are missing, add these two with the same values as the VITE_ ones (and do NOT mark them secret):
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# ---------------------------------------------------------------------------------------------------------------

# Supabase -> Project settings -> API keys: the service_role key (or the "secret" key, sb_secret_...).   [secret]
# It skips the database's security rules, so it lives only here.
# SUPABASE_SERVICE_ROLE_KEY=

# Meta Business settings -> System users -> Generate token (permissions: whatsapp_business_messaging,
# whatsapp_business_management, business_management).                                                    [secret]
# WHATSAPP_ACCESS_TOKEN=

# Meta app dashboard -> WhatsApp -> API Setup: the "Phone number ID" (not the phone number itself).
# WHATSAPP_PHONE_NUMBER_ID=

# The "WhatsApp Business Account ID" from the same page. Only the set-up check uses it, to look up the template.
# WHATSAPP_BUSINESS_ACCOUNT_ID=

# Delivery news (Delivered / Read). Meta app dashboard -> App settings -> Basic -> App secret.           [secret]
# WHATSAPP_APP_SECRET=

# A long phrase you make up (30+ letters and numbers). Type the same phrase into Meta when you set the webhook.  [secret]
# The webhook address is  https://YOUR-SITE.netlify.app/.netlify/functions/whatsapp-webhook
# WHATSAPP_VERIFY_TOKEN=

# Only if you changed them in Meta (the values below are the defaults):
# WHATSAPP_TEMPLATE_NAME=sns_payment_receipt
# WHATSAPP_TEMPLATE_LANGUAGE=en
# WHATSAPP_API_VERSION=v24.0


# ---------------------------------------------------------------------------------------------------------------
# The 5:31 pm late-payment email to the Director (update 52) -- OPTIONAL, and these belong in NETLIFY ONLY.
#
# Every day of the week (Sundays and public holidays too) at 5:31 pm (Nairobi), one minute after the 5:30 pm closing hour, the
# server emails the Director if any transport or expense / purchase payment is still unpaid. It sends nothing when everything
# is paid. Step by step, and
# what to do when an email does not arrive, is in EMAIL-ALERT-SETUP.md. Like the WhatsApp settings above, never put these in
# .env.local, never commit real values, and add them under Netlify -> Project configuration -> Environment variables.
#
# It also needs SUPABASE_SERVICE_ROLE_KEY (above) and reuses VITE_SUPABASE_URL.
# ---------------------------------------------------------------------------------------------------------------

# resend.com -> API Keys -> Create API Key (Sending access). It starts with re_ and is shown once.                [secret]
# RESEND_API_KEY=

# Who the email comes from. Without it the test sender below is used, which Resend only lets you send to the email address
# your Resend account was opened with. Once you have verified a domain in Resend, use an address on it.
# ALERT_EMAIL_FROM=Swahili Net Solution <onboarding@resend.dev>

# Who gets it. Without it the email goes to the Director's own email address in the app. One or more addresses, separated by commas.
# ALERT_EMAIL_TO=

# The address of the site, shown as a link at the bottom of the email. Without it Netlify's own address is used when it has one.
# ALERT_APP_URL=https://your-site.netlify.app
